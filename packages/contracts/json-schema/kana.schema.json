{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nihonpath.com/content/kana.schema.json",
  "title": "KanaContentItem",
  "description": "JSON Schema untuk item suku kata Kana (Hiragana & Katakana) NihonPath (§3.1, §3.4).",
  "type": "object",
  "required": [
    "external_key",
    "type",
    "jlpt_level",
    "character",
    "romaji",
    "kana_type",
    "row",
    "stroke_count",
    "is_diacritic",
    "is_digraph",
    "source"
  ],
  "properties": {
    "external_key": {
      "type": "string",
      "pattern": "^kana:[a-z0-9_-]+:[^:]+$",
      "description": "Kunci unik eksternal kana, misal kana:gojuon:hiragana-a"
    },
    "type": {
      "type": "string",
      "const": "kana"
    },
    "jlpt_level": {
      "type": "integer",
      "const": 0,
      "description": "Level 0 khusus kurikulum fondasi Kana (§3.1)"
    },
    "character": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "description": "Karakter kana (misal あ atau きゃ)"
    },
    "romaji": {
      "type": "string",
      "minLength": 1,
      "description": "Romanisasi Hepburn standar (misal a, ka, kya)"
    },
    "kana_type": {
      "type": "string",
      "enum": ["hiragana", "katakana"],
      "description": "Sistem aksara kana"
    },
    "row": {
      "type": "string",
      "enum": ["a", "ka", "sa", "ta", "na", "ha", "ma", "ya", "ra", "wa", "n"],
      "description": "Kelompok baris pada tabel gojuon"
    },
    "column": {
      "type": "string",
      "enum": ["a", "i", "u", "e", "o"],
      "description": "Kelompok vokal / kolom pada tabel gojuon"
    },
    "stroke_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Jumlah goresan kana"
    },
    "stroke_order_svg": {
      "type": "string",
      "description": "Path berkas SVG urutan goresan"
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["voice", "file"],
        "properties": {
          "voice": { "type": "string" },
          "file": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "is_diacritic": {
      "type": "boolean",
      "description": "Apakah variasi dakuten (teng-teng) atau handakuten (maru)"
    },
    "is_digraph": {
      "type": "boolean",
      "description": "Apakah bentuk gabungan yoon (misal kya, shu, cho)"
    },
    "mnemonic": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "en": { "type": "string" },
        "provenance": {
          "type": "string",
          "enum": ["human_reviewed", "llm_draft"]
        },
        "reviewed_by": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "license"],
        "properties": {
          "name": { "type": "string" },
          "license": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
