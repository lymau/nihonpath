# ==============================================================================
# NihonPath — Local Development Environment Configuration (.env.example)
# Salin file ini menjadi `.env` jika ingin mengubah konfigurasi default lokal
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=nihonpath_dev
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# LocalStack (S3 Object Storage Emulator) Configuration
LOCALSTACK_PORT=4566
AWS_DEFAULT_REGION=ap-southeast-3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Observability Stack Ports
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8888
OTEL_PROM_PORT=8889
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
