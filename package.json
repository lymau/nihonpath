{
  "name": "nihonpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "lint": "pnpm run lint:ts && pnpm run lint:dart",
    "lint:ts": "eslint . --no-warn-ignored",
    "lint:dart": "dart analyze .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "format:dart:check": "dart format --output=none --set-exit-if-changed .",
    "format:dart": "dart format .",
    "format:all": "pnpm run format && pnpm run format:dart",
    "format:all:check": "pnpm run format:check && pnpm run format:dart:check",
    "prepare": "husky || true",
    "commitlint": "commitlint --from=HEAD~1",
    "test": "node --test tests/**/*.test.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "docker:up": "node scripts/docker-runner.mjs up -d",
    "docker:down": "node scripts/docker-runner.mjs down",
    "docker:status": "node scripts/docker-runner.mjs ps",
    "docker:logs": "node scripts/docker-runner.mjs logs -f",
    "docker:verify": "node scripts/verify-local-env.mjs",
    "terraform:fmt": "terraform fmt -recursive infra/terraform",
    "terraform:fmt:check": "terraform fmt -check -recursive infra/terraform",
    "terraform:verify": "node scripts/verify-terraform.mjs",
    "verify:docs": "node scripts/verify-docs.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ],
    "*.dart": [
      "dart format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.20.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "fastify": "^5.12.7",
    "husky": "^9.1.7",
    "kysely": "^0.29.7",
    "lint-staged": "^15.4.3",
    "node-pg-migrate": "^9.0.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.5.0",
    "testcontainers": "^12.2.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
